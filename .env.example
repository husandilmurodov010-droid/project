# AI Manager Bot - sozlamalar namunasi
# Nusxa oling:  cp .env.example .env   va qiymatlarni to'ldiring.
# ⚠️ .env faylini HECH QACHON git'ga qo'shmang (u .gitignore da).

# ----- Telegram -----
BOT_TOKEN=123456:ABC-your-bot-token
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token

# ----- Gemini (5 kalit, vergul bilan) -----
GEMINI_API_KEYS=key1,key2,key3,key4,key5
# yoki alohida:
# GEMINI_KEY_1=
# GEMINI_KEY_2=
# GEMINI_KEY_3=
# GEMINI_KEY_4=
# GEMINI_KEY_5=
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-flash-lite-latest,gemini-3.8-flash,gemini-flash-latest
GEMINI_IMAGE_MODELS=gemini-3.1-flash-image,gemini-3-pro-image
COOLDOWN_SECONDS=60

# ----- Webhook / health server -----
# Render o'zi PORT va RENDER_EXTERNAL_URL beradi.
WEBHOOK_BASE_URL=
WEBHOOK_SECRET=change-me-to-a-random-string
PORT=10000
ENABLE_HEALTH_SERVER=true
SELF_PING_ENABLED=true
SELF_PING_INTERVAL=600
# Lokal ishlash uchun (Render'da kerak emas):
# WEBHOOK_MODE=polling

# ----- Watchdog -----
WATCHDOG_ENABLED=true
WATCHDOG_INTERVAL=300
WATCHDOG_MEMORY_LIMIT_MB=400
WATCHDOG_GC_EVERY=6

# ----- Gist zaxirasi (ixtiyoriy, tavsiya etiladi) -----
BACKUP_ENABLED=false
GITHUB_TOKEN=
GIST_ID=
BACKUP_INTERVAL_SECONDS=3600
RESTORE_ON_START=true

# ----- Admin -----
ADMIN_ID=
ADMIN_USERNAME=Husan_Dilmurodov
ADMIN_PHONE=

# ----- Funksiyalar -----
DB_PATH=bot.db
ENABLE_INSTANT_REPLIES=true
INSTANT_MAX_LEN=60
QUIZ_QUESTIONS_PER_SESSION=5
ENABLE_IMAGE_GEN=true
HISTORY_TURNS=8
LOG_LEVEL=INFO
DEFAULT_LANG=uz
