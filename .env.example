# ===========================================================================
#  AI Manager Bot — muhit o'zgaruvchilari NAMUNASI
# ---------------------------------------------------------------------------
#  Bu faylni nusxalab `.env` yasang:
#      cp .env.example .env
#  va haqiqiy qiymatlarni yozing.
#
#  ⚠️ XAVFSIZLIK: bu fayl GitHub'ga COMMIT QILINADI (u namuna). Shuning uchun
#     bu yerda HECH QACHON haqiqiy token/kalit bo'lmasin — faqat `<...>`
#     ko'rinishidagi o'rn-joylar. Haqiqiy qiymatlar faqat `.env` da (u
#     .gitignore orqali himoyalangan) yoki Render Environment'da turadi.
# ===========================================================================

# --- Telegram --------------------------------------------------------------
# @BotFather dan olinadi.
BOT_TOKEN=<1234567890:AA...>

# --- Gemini API kalitlari --------------------------------------------------
# 5 ta kalit — round-robin + failover bilan parallel ishlatiladi.
# IKKI USUL (ikkisi ham ishlaydi, kerak bo'lsa aralash mumkin):
#
#  (a) BITTA qatorda, vergul bilan:
GEMINI_API_KEYS=<key1>,<key2>,<key3>,<key4>,<key5>
#
#  (b) ALOHIDA o'zgaruvchilar (Render uchun qulay — har birini alohida kiritish):
GEMINI_KEY_1=<key1>
GEMINI_KEY_2=<key2>
GEMINI_KEY_3=<key3>
GEMINI_KEY_4=<key4>
GEMINI_KEY_5=<key5>
#
# Model zaxira zanjiri (fallback): birinchisi kvota/xato bersa — keyingisi.
# MUHIM: "gemini-1.5-flash" Google tomonidan olib tashlangan (404) — ishlatilmaydi.
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.8-flash,gemini-3.5-flash

# --- Render / bulut --------------------------------------------------------
# Render `PORT` ni O'ZI beradi — bu yerga yozish shart emas.
# ENABLE_HEALTH_SERVER=true bo'lsa PORT'da health-check server ko'tariladi
# (Web Service uchun kerak; Background Worker'da PORT bo'lmaydi — avtomatik o'chadi).
ENABLE_HEALTH_SERVER=true
HEALTH_HOST=0.0.0.0

# Self-ping: bepul Web Service 15 daqiqa harakatsizlikdan keyin "uxlaydi".
# RENDER_EXTERNAL_URL Render tomonidan avtomatik beriladi — kod uni o'zi
# topadi, shuning uchun bu yerni bo'sh qoldirish mumkin.
# SELF_PING_URL=
SELF_PING_INTERVAL=600

# --- Ma'lumotlar bazasi ---------------------------------------------------
# Render'da `/var/data/bot.db` (persistent disk bilan) yoki `bot.db` (Gist
# zaxirasi bilan) ishlatiladi. Lokal uchun shunchaki `bot.db`.
DB_PATH=bot.db

# --- Watchdog (uzoq muddatli barqarorlik) ---------------------------------
# Xotira oqib ketishi (memory leak) va event loop bloklanishini kuzatadi.
WATCHDOG_ENABLED=true
WATCHDOG_INTERVAL=300
# Xotira chegarasi (MB). 0 = o'chirilgan. Oshsa — jarayon TOZA qayta ishga
# tushadi (start.sh tiklaydi). Render bepul tarifida ~512 MB RAM bor —
# 400 MB xavfsiz chegara. Lokal/VPS'da 0 qoldirsangiz ham bo'ladi.
WATCHDOG_MEMORY_LIMIT_MB=0
WATCHDOG_GC_EVERY=6

# --- Zaxiralash (GitHub Gist) ---------------------------------------------
# Render BEPUL tarifida disk vaqtinchalik — baza har deploy'da o'chadi.
# true bo'lsa: baza davriy ravishda xususiy Gist'ga zaxiralanadi va bot
# qayta ishga tushganda avtomatik tiklanadi.
BACKUP_ENABLED=false
# GitHub klassik token, faqat `gist` scope bilan: https://github.com/settings/tokens
GITHUB_TOKEN=<ghp_...>
# Birinchi zaxiralashdan keyin log'da yangi GIST_ID chiqadi — uni shu yerga
# yozib qo'ying (keyingi deploy'larda o'sha gist yangilanadi).
GIST_ID=
BACKUP_INTERVAL_SECONDS=3600
RESTORE_ON_START=true

# --- Adminlar -------------------------------------------------------------
# ADMIN_ID — bitta id (Render uchun qulay), ADMIN_IDS — vergul bilan bir nechta.
ADMIN_ID=
ADMIN_IDS=
# Username @ belgisiz (username bo'yicha ham admin aniqlanadi).
ADMIN_USERNAME=Husan_Dilmurodov
ADMIN_USERNAMES=
ADMIN_PHONE=+998 883800311

# --- Ma'lumot fayllari ----------------------------------------------------
INSTANT_REPLIES_FILE=instant_replies.json
QUIZ_DATA_FILE=quiz_data.json
IELTS_SPEAKING_FILE=ielts_speaking.json
IELTS_WRITING_FILE=ielts_writing.json
MATH_TESTS_FILE=math_tests.json
PHYSICS_TESTS_FILE=physics_tests.json

# --- Tezkor javob tizimi --------------------------------------------------
ENABLE_INSTANT_REPLIES=true
# Tezkor javob faqat shu uzunlikdan qisqa xabarlarga qo'llanadi (belgi soni).
INSTANT_MAX_LEN=60

# --- Test (quiz) ----------------------------------------------------------
QUIZ_QUESTIONS_PER_SESSION=5

# --- Suhbat tarixi --------------------------------------------------------
HISTORY_CONTEXT_SIZE=6

# --- Rasm / ovoz ----------------------------------------------------------
ENABLE_IMAGE_GEN=true
IMAGEN_MODEL=imagen-3.0-generate-002
ENABLE_VOICE=true
VOICE_MODEL=gemini-3.5-flash-lite

# --- Eslatmalar -----------------------------------------------------------
REMINDER_CHECK_INTERVAL=30

# --- Kanal boshqaruvi -----------------------------------------------------
# Standart kanal ID (ixtiyoriy). Bo'sh bo'lsa, kanal bot orqali ulanadi.
DEFAULT_CHANNEL_ID=
# Rejalashtirilgan postlarni tekshirish oralig'i (sekund).
POST_CHECK_INTERVAL=30

# --- PDF testlar ----------------------------------------------------------
# PDF dan matn ajratish uchun maksimal fayl hajmi (MB).
PDF_MAX_MB=20
# PDF dan ajratib olinadigan maksimal savol soni.
PDF_MAX_QUESTIONS=200

# --- Logging va so'rovlar -------------------------------------------------
LOG_LEVEL=INFO
LOG_DIR=logs
REQUEST_TIMEOUT=90
MAX_RETRIES_PER_KEY=2
COOLDOWN_SECONDS=60
