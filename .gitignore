# ===========================================================================
#  AI Manager Bot — .gitignore
#  Maqsad: maxfiy ma'lumot (token, kalit), baza, log va kesh HECH QACHON
#  GitHub'ga tushmasin.
# ===========================================================================

# --- Maxfiy sozlamalar ----------------------------------------------------
.env
.env.*
!.env.example
*.env
secrets.json
credentials.json

# --- Ma'lumotlar bazasi (foydalanuvchi ma'lumotlari!) ---------------------
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
data/
!data/.gitkeep

# --- Loglar ---------------------------------------------------------------
logs/
*.log
*.log.*
*.gz

# --- Python kesh ----------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# --- Virtual muhit --------------------------------------------------------
.venv/
venv/
env/
ENV/
.python-version

# --- Test / qamrov --------------------------------------------------------
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/
*.cover
handler_test.db*
test_*.db*

# --- Tahrirlovchi / OS ----------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# --- Render / boshqa platformalar -----------------------------------------
.render/
.vercel/
.netlify/

# --- Zaxira nusxalari -----------------------------------------------------
*.bak
*.tmp
*.orig
backup_*.json
